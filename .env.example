# ── Databricks Workspace ──────────────────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<your-personal-access-token>

# ── Databricks SQL Warehouse ──────────────────────────────────────────────────
# Required — the SQL warehouse used for Silver table product lookups.
# Find it in Databricks → SQL Warehouses → your warehouse → Connection details.
DATABRICKS_SQL_WAREHOUSE_ID=<your-warehouse-id>

# ── Databricks Vector Search ──────────────────────────────────────────────────
DATABRICKS_VECTOR_ENDPOINT=<your-vector-search-endpoint-name>
DATABRICKS_VECTOR_INDEX=sandbox.venkat.bags_embeddings_index_01

# ── LLM Endpoints ─────────────────────────────────────────────────────────────
DATABRICKS_CHAT_ENDPOINT=databricks-meta-llama-3-1-8b-instruct
DATABRICKS_INTENT_ENDPOINT=databricks-meta-llama-3-1-8b-instruct
DATABRICKS_EMBEDDING_ENDPOINT=databricks-bge-large-en

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://<your-app-url>/auth/callback

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=<your-random-secret-key>

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<your-jwt-signing-secret>

# ── Pinecone (optional fallback vector store) ─────────────────────────────────
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=<your-pinecone-index-name>

# ── Service Principal (optional — for non-PAT auth) ───────────────────────────
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>

# ── audit wrapper ───────────────────────────
AUDIT_APP_ID=<app_id shared by platform team during onboarding>
AUDIT_CATALOG=<catalog name shared by admin, e.g. shopping_assistant>
AUDIT_SECRET_SCOPE=audit_trail_secrets
DATABRICKS_SQL_WAREHOUSE_ID=<warehouse ID shared by admin>
DATABRICKS_HOST=<workspace URL, e.g. https://adb-xxxx.azuredatabricks.net>
DATABRICKS_TOKEN=<personal access token>